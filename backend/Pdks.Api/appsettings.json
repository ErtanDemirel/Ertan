  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=PdksDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "PdksApi",
    "Audience": "PdksClients",
    "Key": "DEGISTIRIN-uretimde-en-az-32-karakterlik-gizli-anahtar!",
