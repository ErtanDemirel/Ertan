    "RefreshTokenDays": 14
  },
  "Otp": {
    "Length": 6,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5
  },
  "Sms": {
    "Provider": "Console",
    "ApiUrl": "",
    "Username": "",
    "Password": "",
    "Sender": "COKOSIS"
  },
